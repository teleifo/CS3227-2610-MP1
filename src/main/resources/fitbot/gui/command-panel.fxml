<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<TitledPane text="Command Center" expanded="false"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fitbot.gui.CommandPanelController">
    <content>
        <VBox spacing="10" styleClass="command-panel-content">
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="command-input-row">
                <Label text="Command:" styleClass="command-label" />
                <TextField fx:id="commandInput" promptText="Enter a command, for example: help"
                           HBox.hgrow="ALWAYS" onAction="#submitCommand" />
                <Button text="?" onAction="#showHelp" />
                <Button text="Run" defaultButton="true" onAction="#submitCommand" />
            </HBox>
            <TextArea fx:id="commandOutput" editable="false" wrapText="true"
                      prefRowCount="8" styleClass="command-output"
                      promptText="Command output will appear here." />
        </VBox>
    </content>
</TitledPane>
