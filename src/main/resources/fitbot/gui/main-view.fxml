<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fitbot.gui.MainController">
    <center>
        <HBox fx:id="mainContent">
            <VBox minWidth="220.0" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-padding: 10px 14px; -fx-background-color: #353b48;">
                    <Label text="Filter workouts:" style="-fx-text-fill: #ffffff;" />
                    <ComboBox fx:id="workoutFilter" prefWidth="140.0"
                              styleClass="filter-combo"
                              style="-fx-background-color: #353b48; -fx-border-color: #dfe4ea;" />
                </HBox>
                <StackPane fx:id="workoutListContainer" minWidth="220.0" VBox.vgrow="ALWAYS" />
            </VBox>
            <Separator orientation="VERTICAL" prefWidth="1.0" minWidth="1.0" maxWidth="1.0" />
            <StackPane fx:id="workoutDetailContainer" minWidth="260.0" HBox.hgrow="ALWAYS" />
        </HBox>
    </center>
    <bottom><StackPane fx:id="commandPanelContainer" /></bottom>
</BorderPane>
